# ==============================================================================
# CONFIGURAÇÕES GERAIS - GT CURSOS (EXEMPLO DE VARIÁVEIS DE AMBIENTE)
# ==============================================================================

# 1. Configurações de Acesso ao Banco de Dados MySQL
DB_HOST=localhost
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=senha_do_banco
DB_CHARSET=utf8mb4

# 2. Credenciais de API - Mercado Pago (Checkout Transparente)
MERCADO_PAGO_PUBLIC_KEY=sua_chave_publica_mercado_pago
MERCADO_PAGO_ACCESS_TOKEN=seu_access_token_mercado_pago

# 3. Credenciais de API - Gmail (PHPMailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_gmail_16_digitos

# 4. Credenciais de API - Discloud (WhatsApp API)
WHATSAPP_API_URL=https://api.discloud.bot/v1/whatsapp/send
WHATSAPP_API_TOKEN=seu_token_de_api_discloud_whatsapp

# 5. Configurações de Bunny.net Video Stream
BUNNY_STREAM_BASE_URL=https://iframe.mediadelivery.net/embed/

# 6. Configurações Gerais do Ambiente
APP_URL=https://cursos.gtservtec.com.br
DEV_MODE=false
