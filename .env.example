# ==============================================================================
# CONFIGURAÇÕES GERAIS - MODELO (.env.example)
# ==============================================================================

# 1. Configurações de Acesso ao Banco de Dados MySQL
DB_HOST=localhost
DB_NAME=seu_banco_de_dados
DB_USER=seu_usuario_banco
DB_PASS=sua_senha_banco
DB_CHARSET=utf8mb4

# 2. Credenciais de API - Mercado Pago (Checkout Transparente)
MERCADO_PAGO_PUBLIC_KEY=sua_chave_publica_aqui
MERCADO_PAGO_ACCESS_TOKEN=seu_access_token_aqui
MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# 3. Credenciais de API - Gmail (PHPMailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email_gmail@gmail.com
SMTP_PASS=sua_senha_de_app_gmail

# 4. Credenciais de API - Discloud (WhatsApp API)
WHATSAPP_API_URL=https://bot-eloha.discloud.app
WHATSAPP_API_TOKEN=seu_token_discloud_aqui

# 5. Configurações de Bunny.net Video Stream
BUNNY_STREAM_BASE_URL=https://iframe.mediadelivery.net/embed/

# 6. Configurações Gerais do Ambiente
APP_URL=https://cursos.gtservtec.com.br
DEV_MODE=false
