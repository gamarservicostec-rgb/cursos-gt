# ====================================================
# CONFIGURAÇÃO DE ROTAS E REDIRECIONAMENTO — GT CURSOS
# ====================================================

RewriteEngine On

# 1. Bloqueia acesso direto a pastas confidenciais e arquivos de regras
RewriteRule ^(src|storage|logs|database|\.rules|\.workflows) - [F,L]

# 2. Redirecionamento transparente da raiz para a pasta /public/
RewriteRule ^$ public/index.php [L]

# 3. Redirecionamento transparente de todas as demais requisições para a pasta /public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^((?!public/).*)$ public/$1 [L]
